DATABASE_NAME=opensources
DATABASE_URL=jdbc:postgresql://localhost:5432/opensources
DATABASE_USER=opensources
DATABASE_PASSWORD=opensources
DATABASE_PORT=5432
DATABASE_POOL_SIZE=10
MIGRATIONS_LOCATION=filesystem:../database/migrations
BACKEND_PORT=8080
# Backend HTTP hardening. Replace the local origin in deployed environments.
CORS_ALLOWED_ORIGINS=http://localhost:3000
HTTP_MAX_REQUEST_BODY_BYTES=1048576
HTTP_REQUEST_READ_TIMEOUT_SECONDS=30
HTTP_RESPONSE_WRITE_TIMEOUT_SECONDS=30
# Comma-separated reverse-proxy addresses allowed to supply X-Forwarded-For.
TRUSTED_PROXY_ADDRESSES=
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=opensources
JWT_AUDIENCE=opensources-api
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_SECONDS=2592000
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_LOGIN_FAILURE_THRESHOLD=5
AUTH_LOGIN_LOCKOUT_BASE_SECONDS=60
AUTH_LOGIN_LOCKOUT_MAX_SECONDS=900
PRODUCT_NAME=opensources
PRODUCT_DESCRIPTION=A reusable SaaS foundation
PRODUCT_LOGO=/opensources-mark.png
PRODUCT_DEFAULT_LOCALE=en
PRODUCT_DEFAULT_TIMEZONE=UTC
PRODUCT_SUPPORT_EMAIL=support@opensources.local
PRODUCT_APPLICATION_URL=http://localhost:3000
PRODUCT_ENABLED_MODULES=billing
# Legacy compatibility switch; prefer PRODUCT_ENABLED_MODULES.
FEATURE_BILLING_ENABLED=true
NEXT_PUBLIC_FEATURE_BILLING_ENABLED=true
EMAIL_PROVIDER=logging
EMAIL_FROM=no-reply@opensources.local
RESEND_API_KEY=
APP_BASE_URL=http://localhost:3000
EMAIL_VERIFICATION_EXPIRATION_SECONDS=86400
PASSWORD_RESET_EXPIRATION_SECONDS=3600
INVITATION_EXPIRATION_SECONDS=604800
