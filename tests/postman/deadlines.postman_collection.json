            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{managedUserEmail}}\",\n  \"firstName\": \"Managed\",\n  \"lastName\": \"User\"\n}" },
            "url": "{{baseUrl}}/api/v1/users"
          }
        },
        {
          "name": "List users",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/users?page=1&limit=20" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Get user",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/api/v1/users/{{managedUserId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Update user",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Updated\"\n}" },
            "url": "{{baseUrl}}/api/v1/users/{{managedUserId}}"
          },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 200', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Disable user",
          "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/api/v1/users/{{managedUserId}}" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('status is 204', () => pm.response.to.have.status(204));"] } }]
        }
      ]
    },
    {
      "name": "Audits (Owner only)",
      "item": [
        {
          "name": "List audit history",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/audits?limit=20&offset=0"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('scoped to current organization', () => pm.response.json().data.forEach(event => pm.expect(event.organizationId).to.eql(pm.collectionVariables.get('organizationId'))));",
                  "pm.test('pagination', () => pm.expect(pm.response.json().hasMore).to.be.a('boolean'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Filter organization changes",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/audits?action=organization.updated&limit=10"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('scoped to current organization', () => pm.response.json().data.forEach(event => pm.expect(event.organizationId).to.eql(pm.collectionVariables.get('organizationId'))));",
                  "pm.test('pagination', () => pm.expect(pm.response.json().hasMore).to.be.a('boolean'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Reject invalid page size",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": "{{baseUrl}}/api/v1/audits?limit=101"
          },
          "event": [
